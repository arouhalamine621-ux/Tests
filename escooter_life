local function applySpeed()
    pcall(function()
        local hum = getHum(); if not hum then return end
        hum.WalkSpeed = S.speed and SPEED_TIERS[S.speedTier] or 16
        hum.JumpPower = S.speed and 80 or 50
    end)
end
LP.CharacterAdded:Connect(function() task.delay(1, applySpeed) end)

-- ================================================================
-- INFINITE BOOST — fills any "Boost" / "Energy" value each tick
-- ================================================================
local function startInfiniteBoost()
    if connections.boost then connections.boost:Disconnect() end
    connections.boost = RunService.Heartbeat:Connect(function()
        if not S.infiniteBoost then return end
        pcall(function()
            local char = getChar(); if not char then return end
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    local n = v.Name:lower()
                    if n:find("boost") or n:find("energy") or n:find("stamina") or n:find("fuel") then
                        v.Value = v.Value < (v.MaxValue or 100) - 5
                            and (v.MaxValue or 100) or v.Value
                    end
                end
            end
            -- also check leaderstats / PlayerGui bars
            local stats = LP:FindFirstChild("leaderstats")
            if stats then
                for _, v in ipairs(stats:GetChildren()) do
                    local n = v.Name:lower()
                    if n:find("boost") or n:find("energy") then
                        pcall(function() v.Value = 999999 end)
                    end
                end
            end
        end)
    end)
end

-- ================================================================
-- NO CLIP
-- ================================================================
local function startNoClip()
    if connections.noclip then connections.noclip:Disconnect() end
    connections.noclip = RunService.Stepped:Connect(function()
        if not S.noClip then return end
        pcall(function()
            local char = getChar(); if not char then return end
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end)
    end)
end

local function stopNoClip()
    if connections.noclip then
        connections.noclip:Disconnect()
        connections.noclip = nil
    end
    pcall(function()
        local char = getChar(); if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end)
end

-- ================================================================
-- FLY
-- ================================================================
local function startFly()
    local root = getRoot(); if not root then return end
    local hum  = getHum()
    if hum then hum.PlatformStand = true end

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.Velocity        = Vector3.zero
    flyBodyVel.MaxForce        = Vector3.new(1e5,1e5,1e5)
    flyBodyVel.P               = 1e4
    flyBodyVel.Parent          = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque      = Vector3.new(1e5,1e5,1e5)
    flyBodyGyro.P              = 1e4
    flyBodyGyro.CFrame         = root.CFrame
    flyBodyGyro.Parent         = root

    local SPEED = 60
    if connections.fly then connections.fly:Disconnect() end
    connections.fly = RunService.Heartbeat:Connect(function()
        if not S.fly then return end
        pcall(function()
            local cam = workspace.CurrentCamera
            local mv  = Vector3.zero
            -- keyboard
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv = mv + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv = mv - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv = mv - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv = mv + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.Q) then
                mv = mv + Vector3.new(0,1,0)
            end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.E) then
                mv = mv - Vector3.new(0,1,0)
            end
            -- mobile: use camera direction
            if mv.Magnitude < 0.01 then
                local moveDir = LP.Character
                    and LP.Character:FindFirstChildOfClass("Humanoid")
                    and LP.Character:FindFirstChildOfClass("Humanoid").MoveDirection
                    or Vector3.zero
                if moveDir.Magnitude > 0.1 then
                    mv = cam.CFrame.LookVector * moveDir.Z * -1
                        + cam.CFrame.RightVector * moveDir.X
                end
            end

            if mv.Magnitude > 0 then
                mv = mv.Unit * SPEED
            end
            flyBodyVel.Velocity  = mv
            flyBodyGyro.CFrame   = workspace.CurrentCamera.CFrame
        end)
    end)
end

local function stopFly()
    if connections.fly then connections.fly:Disconnect(); connections.fly = nil end
    pcall(function()
        if flyBodyVel  then flyBodyVel:Destroy();  flyBodyVel  = nil end
        if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
        local hum = getHum()
        if hum then hum.PlatformStand = false end
    end)
end

