-- finds the scooter seat/vehicle the player is sitting on
local function getVehicleSeat()
    local char = getChar(); if not char then return nil end
    local hum  = getHum();  if not hum  then return nil end
    -- SeatPart is set when humanoid is seated
    if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        return hum.SeatPart
    end
    -- fallback: scan workspace for VehicleSeat the player occupies
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") then
            if obj.Occupant == hum then
                return obj
            end
        end
    end
    return nil
end

local function startWheelie()
    if connections.wheelie then connections.wheelie:Disconnect() end
    connections.wheelie = RunService.Heartbeat:Connect(function()
        pcall(function()
            -- prefer the vehicle seat — that's what actually tilts the scooter
            local seat = getVehicleSeat()
            if seat then
                local _, yaw, _ = seat.CFrame:ToEulerAnglesYXZ()
                seat.CFrame = CFrame.new(seat.Position)
                    * CFrame.fromEulerAnglesYXZ(math.rad(-S.wheelieAngle), yaw, 0)
                return
            end
            -- fallback: tilt HRP directly (on foot)
            local root = getRoot(); if not root then return end
            local _, yaw, _ = root.CFrame:ToEulerAnglesYXZ()
            root.CFrame = CFrame.new(root.Position)
                * CFrame.fromEulerAnglesYXZ(math.rad(-S.wheelieAngle), yaw, 0)
        end)
    end)
end

local function stopWheelie()
    if connections.wheelie then
        connections.wheelie:Disconnect()
        connections.wheelie = nil
    end
    -- restore vehicle seat upright
    pcall(function()
        local seat = getVehicleSeat()
        if seat then
            local _, yaw, _ = seat.CFrame:ToEulerAnglesYXZ()
            seat.CFrame = CFrame.new(seat.Position) * CFrame.fromEulerAnglesYXZ(0, yaw, 0)
            return
        end
        local root = getRoot(); if not root then return end
        local _, yaw, _ = root.CFrame:ToEulerAnglesYXZ()
        root.CFrame = CFrame.new(root.Position) * CFrame.fromEulerAnglesYXZ(0, yaw, 0)
    end)
end

-- ================================================================
-- FARM
-- ================================================================
local KEYWORDS = {
    "coin","cash","money","xp","gem","token","reward",
    "star","pickup","collectible","note","bill","drop"
}

local function nameHit(n)
    n = n:lower()
    for _, k in ipairs(KEYWORDS) do
        if n:find(k) then return true end
    end
    return false
end

local function doCollect()
    local root = getRoot(); if not root then return end
    local now  = tick()
    if now - collectTimer < 2.5 then return end
    collectTimer = now
    collectDone  = {}

    for _, obj in ipairs(workspace:GetChildren()) do
        if nameHit(obj.Name) then
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (part.Position - root.Position).Magnitude
                if dist < 80 then
                    local id = part:GetDebugId()
                    if not collectDone[id] then
                        collectDone[id] = true
                        pcall(function()
                            local cd = part:FindFirstChildOfClass("ClickDetector")
                                or obj:FindFirstChildOfClass("ClickDetector")
                            if cd then fireclickdetector(cd) end
                        end)
                        pcall(function()
                            local pp = part:FindFirstChildOfClass("ProximityPrompt")
                                or obj:FindFirstChildOfClass("ProximityPrompt")
                            if pp then fireproximityprompt(pp) end
                        end)
                        -- touch collect
                        if part:FindFirstChildOfClass("TouchTransmitter") then
                            local orig = root.CFrame
                            root.CFrame = part.CFrame + Vector3.new(0,3,0)
                            task.delay(0.05, function()
                                pcall(function() root.CFrame = orig end)
                            end)
                        end
                    end
                end
            end
        end
    end
end

local function startFarm()
    if connections.farm then connections.farm:Disconnect() end
    connections.farm = RunService.Heartbeat:Connect(function()
        if S.farm then pcall(doCollect) end
    end)
end

