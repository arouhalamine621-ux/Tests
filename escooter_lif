-- FLY
-- ================================================================
local function startFly()
    local root = getRoot(); if not root then return end
    local hum  = getHum()
    if hum then hum.PlatformStand = true end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Velocity  = Vector3.zero
    flyBV.MaxForce  = Vector3.new(1e5,1e5,1e5)
    flyBV.P         = 1e4
    flyBV.Parent    = root

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e5,1e5,1e5)
    flyBG.P         = 1e4
    flyBG.CFrame    = root.CFrame
    flyBG.Parent    = root

    if conns.fly then conns.fly:Disconnect() end
    conns.fly = RunService.Heartbeat:Connect(function()
        if not S.fly then return end
        pcall(function()
            local cam = workspace.CurrentCamera
            local mv  = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv = mv + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv = mv - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv = mv - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv = mv + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv = mv - Vector3.new(0,1,0) end
            -- mobile joystick
            local mdir = getHum() and getHum().MoveDirection or Vector3.zero
            if mv.Magnitude < 0.01 and mdir.Magnitude > 0.1 then
                mv = cam.CFrame.LookVector*(-mdir.Z) + cam.CFrame.RightVector*mdir.X
            end
            flyBV.Velocity = mv.Magnitude > 0 and mv.Unit*80 or Vector3.zero
            flyBG.CFrame   = cam.CFrame
        end)
    end)
end

local function stopFly()
    if conns.fly then conns.fly:Disconnect(); conns.fly = nil end
    pcall(function()
        if flyBV  then flyBV:Destroy();  flyBV  = nil end
        if flyBG  then flyBG:Destroy(); flyBG  = nil end
        local hum = getHum()
        if hum then hum.PlatformStand = false end
    end)
end

