-- ================================================================
-- WHEELIE — fires accelerate + holds tilt + balances
-- ================================================================
local wheelieGyro = nil

local function startWheelie()
    if conns.wheelie then conns.wheelie:Disconnect() end

    conns.wheelie = RunService.Heartbeat:Connect(function()
        pcall(function()
            local seat, vehicle = getVehicle()

            -- ── VEHICLE SEAT MODE ─────────────────────────────
            if seat and seat:IsA("VehicleSeat") then
                -- hold throttle at max
                seat.ThrottleFloat = 1

                -- tilt the whole vehicle model back
                local model = vehicle or seat
                local primary = model:IsA("Model") and model.PrimaryPart or seat
                if primary then
                    local _, yaw, _ = primary.CFrame:ToEulerAnglesYXZ()
                    -- smooth lerp toward target angle
                    local target = CFrame.new(primary.Position)
                        * CFrame.fromEulerAnglesYXZ(math.rad(-S.wheelieAngle), yaw, 0)
                    primary.CFrame = primary.CFrame:Lerp(target, 0.18)
                end

                -- keep front wheel off ground via BodyGyro on seat
                if not wheelieGyro or not wheelieGyro.Parent then
                    wheelieGyro = Instance.new("BodyGyro")
                    wheelieGyro.MaxTorque = Vector3.new(1e6, 0, 1e6)
                    wheelieGyro.P         = 8000
                    wheelieGyro.D         = 500
                    wheelieGyro.Parent    = seat
                end
                local _, yaw2, _ = seat.CFrame:ToEulerAnglesYXZ()
                wheelieGyro.CFrame = CFrame.fromEulerAnglesYXZ(
                    math.rad(-S.wheelieAngle), yaw2, 0
                )

                -- fire wheelie remotes if any exist
                pcall(function()
                    local rs = game:GetService("ReplicatedStorage")
                    for _, re in ipairs(rs:GetDescendants()) do
                        if re:IsA("RemoteEvent") then
                            local n = re.Name:lower()
                            if n:find("wheelie") or n:find("trick") or n:find("stunt") then
                                re:FireServer("wheelie", true)
                            end
                        end
                    end
                end)
                return
            end

            -- ── HRP FALLBACK (on foot / unknown vehicle) ──────
            local root = getRoot(); if not root then return end
            local _, yaw, _ = root.CFrame:ToEulerAnglesYXZ()
            root.CFrame = root.CFrame:Lerp(
                CFrame.new(root.Position)
                    * CFrame.fromEulerAnglesYXZ(math.rad(-S.wheelieAngle), yaw, 0),
                0.18
            )
        end)
    end)
end

local function stopWheelie()
    if conns.wheelie then conns.wheelie:Disconnect(); conns.wheelie = nil end
    pcall(function()
        if wheelieGyro then wheelieGyro:Destroy(); wheelieGyro = nil end
        local seat = getVehicle()
        if seat then
            seat.ThrottleFloat = 0
            local _, yaw, _ = seat.CFrame:ToEulerAnglesYXZ()
            seat.CFrame = CFrame.new(seat.Position)
                * CFrame.fromEulerAnglesYXZ(0, yaw, 0)
        end
    end)
end

-- ================================================================
-- FARM — moves to collectibles + collectibles at full speed
-- ================================================================
local KEYWORDS = {
    "coin","cash","money","xp","gem","token","reward",
    "star","pickup","collectible","note","bill","drop","credit"
}
local function nameHit(n)
    n = n:lower()
    for _, k in ipairs(KEYWORDS) do if n:find(k) then return true end end
    return false
end

local function buildWaypoints()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if nameHit(obj.Name) then
            local part = obj:IsA("BasePart") and obj
                or obj:FindFirstChildWhichIsA("BasePart")
            if part then table.insert(list, part) end
        end
    end
    -- also grab all checkpoints
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("checkpoint") or n:find("waypoint") then
                table.insert(list, obj)
            end
        end
    end
    return list
end

local function collectAt(part)
    pcall(function()
        local cd = part:FindFirstChildOfClass("ClickDetector")
            or part.Parent:FindFirstChildOfClass("ClickDetector")
        if cd then fireclickdetector(cd) end
    end)
    pcall(function()
        local pp = part:FindFirstChildOfClass("ProximityPrompt")
            or part.Parent:FindFirstChildOfClass("ProximityPrompt")
        if pp then fireproximityprompt(pp) end
    end)
    pcall(function()
        local root = getRoot(); if not root then return end
        if part:FindFirstChildOfClass("TouchTransmitter")
        or part.Parent:FindFirstChildOfClass("TouchTransmitter") then
            local orig = root.CFrame
            root.CFrame = part.CFrame + Vector3.new(0,3,0)
            task.delay(0.05, function() pcall(function() root.CFrame = orig end) end)
        end
    end)
    -- fire any collect remotes
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        for _, re in ipairs(rs:GetDescendants()) do
            if re:IsA("RemoteEvent") then
                local n = re.Name:lower()
                if n:find("collect") or n:find("coin") or n:find("pickup") or n:find("cash") then
                    re:FireServer(part)
                end
            end
        end
    end)
end

-- farmMoveConn removed — farm uses conns.farm only

local function driveTo(targetPos)
    -- steer scooter OR walk toward position
    pcall(function()
        local root = getRoot(); if not root then return end
        local hum  = getHum();  if not hum  then return end
        local seat, vehicle = getVehicle()

        if seat and seat:IsA("VehicleSeat") then
            -- on scooter: set throttle + steer
            seat.ThrottleFloat = 1

            -- calculate angle between scooter facing and target
            local toTarget = (targetPos - root.Position) * Vector3.new(1,0,1)
            if toTarget.Magnitude < 0.1 then return end
            toTarget = toTarget.Unit

            local facing = root.CFrame.LookVector * Vector3.new(1,0,1)
            if facing.Magnitude < 0.1 then return end
            facing = facing.Unit

            local cross = facing:Cross(toTarget)
            local dot   = facing:Dot(toTarget)
            local steer = cross.Y > 0 and 1 or -1
            if math.abs(cross.Y) < 0.1 and dot > 0 then steer = 0 end

            seat.SteerFloat = steer
        else
            -- on foot: just walk
            hum.WalkSpeed = 220
            hum:MoveTo(targetPos)
        end
    end)
end

local function startFarm()
    if conns.farm then
        pcall(task.cancel, conns.farm)
        conns.farm = nil
    end

    farmWaypoints = buildWaypoints()
    -- if no collectibles found, build a grid of map waypoints to patrol
    if #farmWaypoints < 3 then
        for x = -300, 300, 80 do
            for z = -300, 300, 80 do
                table.insert(farmWaypoints, {Position = Vector3.new(x, 0, z), Parent = workspace})
            end
        end
    end
    farmIdx = 1

    -- move loop — runs every 0.15s, mobile safe
    conns.farm = task.spawn(function()
        while S.farm do
            local ok, err = pcall(function()
                local root = getRoot(); if not root then return end

                if #farmWaypoints == 0 then
                    farmWaypoints = buildWaypoints()
                    return
                end

                -- skip destroyed parts
                local attempts = 0
                while attempts < #farmWaypoints do
                    local target = farmWaypoints[farmIdx]
                    if target and target.Parent then break end
                    farmIdx = (farmIdx % #farmWaypoints) + 1
                    attempts = attempts + 1
                end

                local target = farmWaypoints[farmIdx]
                if not target or not target.Parent then return end

                local targetPos = Vector3.new(target.Position.X, target.Position.Y + 3, target.Position.Z)
                local dist = (targetPos - root.Position).Magnitude

                if dist < 12 then
                    collectAt(target)
                    farmIdx = (farmIdx % #farmWaypoints) + 1
                else
                    driveTo(targetPos)
                end
            end)
            if not ok then
                warn("[XV Farm] "..tostring(err))
            end
            task.wait(0.15)
        end
    end)
end

local function stopFarm()
    S.farm = false
    if conns.farm then
        pcall(task.cancel, conns.farm)
        conns.farm = nil
    end
    pcall(function()
        local seat = getVehicle()
        if seat then seat.ThrottleFloat = 0; seat.SteerFloat = 0 end
        local hum = getHum()
        if hum then hum.WalkSpeed = S.speed and SPEED_TIERS[S.speedTier] or 16 end
    end)
end

